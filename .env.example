# Storj configuration (main service)
STORJ_ACCESS_GRANT_SFW=your_storj_sfw_access_grant
SFW_BUCKET=yral-videos
STORJ_ACCESS_GRANT_NSFW=your_storj_nsfw_access_grant
NSFW_BUCKET=yral-nsfw-videos

# Storj configuration (backfill-thumbnails operator)
STORJ_ACCESS_GRANT=your_storj_access_grant
TEST_BUCKET=your_test_bucket_name

# Hetzner S3 configuration (for SFW videos)
HETZNER_S3_ENDPOINT=https://your-bucket.s3.eu-central-1.hetzner.com
HETZNER_S3_BUCKET=your-bucket-name
HETZNER_S3_ACCESS_KEY=your_access_key
HETZNER_S3_SECRET_KEY=your_secret_key
HETZNER_S3_REGION=eu-central

# Service authentication
SERVICE_SECRET_TOKEN=your_shared_secret_token

# HA PostgreSQL cluster (Patroni + etcd)
POSTGRES_SUPERUSER_PASSWORD=change-me-in-production
REPLICATOR_PASSWORD=change-me-in-production
APP_DB_PASSWORD=change-me-in-production
PATRONI_API_PASSWORD=change-me-in-production
# Space-separated public CIDRs allowed to connect to Postgres on 15432 as readonly clients.
POSTGRES_READONLY_ALLOWLIST=
# Access grant scoped to yral-sfw on EU1 satellite (separate from STORJ_ACCESS_GRANT_SFW)
STORJ_MIRROR_ACCESS_GRANT=your_storj_eu1_yral_sfw_access_grant
# S3 gateway credentials derived from STORJ_MIRROR_ACCESS_GRANT via:
#   uplink access register --auth-service https://auth.eu1.storjshare.io <access-grant>
STORJ_EU1_GATEWAY_ACCESS_KEY=
STORJ_EU1_GATEWAY_SECRET_KEY=
STORJ_SFW_BUCKET=yral-sfw
PHASH_CONCURRENCY=4
MIRROR_CONCURRENCY=8
SCAN_PAGE_SIZE=1000
MAX_PHASH_RETRIES=5
TEMP_KEY_PREFIX=_pending/
